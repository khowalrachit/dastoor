[sub_resource type="GDScript" id="GDScript_3vyb7"]
script/source = "extends CharacterBody2D

const SPEED = 130.0
const JUMP_VELOCITY = -300.0
# Touch controls variables
var swipe_start = null
var touch_direction = 0
const MIN_SWIPE_DISTANCE = 50  # Minimum pixels to recognize as a swipe

func _input(event):
	# Handle touch events for swipe detection
	if event is InputEventScreenTouch:
		if event.pressed:
			# Record start position when screen is touched
			swipe_start = event.position
		else:
			# Reset direction when touch is released
			touch_direction = 0
			swipe_start = null
	
	# Handle swipe motion
	if event is InputEventScreenDrag and swipe_start != null:
		var swipe_end = event.position
		var swipe_vector = swipe_end - swipe_start
		
		# Check if swipe meets minimum distance requirement
		if abs(swipe_vector.x) > MIN_SWIPE_DISTANCE:
			# Set direction based on swipe horizontal direction
			touch_direction = sign(swipe_vector.x)

func _physics_process(delta: float) -> void:
	# Add gravity
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Handle jump
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Combine keyboard and touch inputs
	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if direction == 0:
		direction = touch_direction  # Use touch input if no keyboard input
	
	# Apply movement
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	move_and_slide()
"

